# Without DATABASE_URL the site runs status-checks only. Without SMTP_* no emails are sent.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Public base URL used to build unsubscribe links in emails.
BASE_URL=http://localhost:8000

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

POLL_INTERVAL_MINUTES=5
HTTP_TIMEOUT_SECONDS=20

# Resend SMTP. The username is literally "resend" and the password is your Resend API key.
# SMTP_FROM_EMAIL must be on a domain verified in Resend (e.g. cunytracker.com).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=your-resend-api-key
SMTP_FROM_EMAIL=alerts@your-verified-domain.com
SMTP_FROM_NAME=CUNY Tracker

# 587 = STARTTLS. For implicit TLS use 465 with SMTP_USE_SSL=true.
SMTP_USE_SSL=false
SMTP_STARTTLS=true
